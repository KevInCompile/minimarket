// Prisma schema para minimarket

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAJERO
}

enum PagadoCon {
  CAJA
  EFECTIVO
}

enum SaleDe {
  EFECTIVO
  NEQUI
  CAJA
}

enum TipoRetiro {
  ARRIENDO
  NOMINA
  SERVICIOS
  IMPUESTOS
  PRESTAMO
  RETIRO_PERSONAL
  OTRO
}

/// Una tienda = un cliente de la app. Cada User pertenece a una Tienda,
/// y todos los datos (Gasto, Retiro, NequiDelDia, CierreDiario,
/// Proveedor, PedidoNota) están aislados por tienda.
model Tienda {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  email     String?
  telefono  String?
  direccion String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  proveedores Proveedor[]
  gastos      Gasto[]
  retiros     Retiro[]
  nequiDias   NequiDelDia[]
  cierres     CierreDiario[]
  pedidos     PedidoNota[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(CAJERO)
  activo       Boolean  @default(true)
  tiendaId     String
  tienda       Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  gastos        Gasto[]
  retiros       Retiro[]
  nequiUpdates  NequiDelDia[]
  cierres       CierreDiario[]

  @@index([tiendaId])
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  gastos  Gasto[]
  pedidos PedidoNota[]

  @@unique([nombre, tiendaId])
  @@index([tiendaId])
}

model Gasto {
  id          String    @id @default(cuid())
  fecha       DateTime  @db.Date
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  valor       Int
  pagadoCon   PagadoCon
  nota        String?
  tiendaId    String
  tienda      Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([fecha])
  @@index([proveedorId])
  @@index([userId])
  @@index([tiendaId])
}

model Retiro {
  id       String   @id @default(cuid())
  fecha    DateTime @db.Date
  tipo     TipoRetiro @default(OTRO)
  concepto String
  valor    Int
  saleDe   SaleDe
  nota     String?
  tiendaId String
  tienda   Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([fecha])
  @@index([userId])
  @@index([tipo])
  @@index([tiendaId])
}

model NequiDelDia {
  id        String   @id @default(cuid())
  fecha     DateTime @unique @db.Date
  total     Int
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([tiendaId])
}

model CierreDiario {
  id                  String   @id @default(cuid())
  fecha               DateTime @unique @db.Date
  cajaApertura        Int      @default(0)
  cajaCierre          Int      @default(0)
  efectivoGuardado    Int      @default(0)
  efectivoRealContado Int?
  tiendaId            String
  tienda              Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userIdCierre        String
  user                User     @relation(fields: [userIdCierre], references: [id], onDelete: Cascade)
  updatedAt           DateTime @updatedAt

  @@index([tiendaId])
}

model PedidoNota {
  id          String   @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  valor       Int
  dia         String
  estado      String?
  nota        String?
  tiendaId    String
  tienda      Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tiendaId])
}
