// Prisma schema para minimarket

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAJERO
}

enum PagadoCon {
  CAJA
  EFECTIVO
  TRANSFERENCIA
}

enum SaleDe {
  EFECTIVO
  TRANSFERENCIA
  CAJA
}

enum TipoRetiro {
  ARRIENDO
  NOMINA
  SERVICIOS
  IMPUESTOS
  PRESTAMO
  RETIRO_PERSONAL
  OTRO
}

/// Una tienda = un cliente de la app. Cada User pertenece a una Tienda,
/// y todos los datos (Gasto, Retiro, TransferenciaDia, CierreDiario,
/// Proveedor, PedidoNota) están aislados por tienda.
model Tienda {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  email     String?
  telefono  String?
  direccion String?
  activa    Boolean  @default(true)
  /// Dia del mes (1-28) en que se reinicia el periodo de la tienda.
  /// Con 1 el periodo es el mes calendario; con 15 el periodo va del 15
  /// de un mes al 14 del siguiente. Cada negocio tiene su corte.
  diaCorte  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  proveedores Proveedor[]
  gastos      Gasto[]
  retiros     Retiro[]
  transferencias  TransferenciaDia[]
  cierres     CierreDiario[]
  pedidos     PedidoNota[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(CAJERO)
  activo       Boolean  @default(true)
  tiendaId     String
  tienda       Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  gastos        Gasto[]
  retiros       Retiro[]
  transferencias  TransferenciaDia[]
  cierres       CierreDiario[]

  @@index([tiendaId])
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  gastos  Gasto[]
  pedidos PedidoNota[]

  @@unique([nombre, tiendaId])
  @@index([tiendaId])
}

model Gasto {
  id          String    @id @default(cuid())
  fecha       DateTime  @db.Date
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  valor       Int
  pagadoCon   PagadoCon
  nota        String?
  tiendaId    String
  tienda      Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([fecha])
  @@index([proveedorId])
  @@index([userId])
  @@index([tiendaId])
}

model Retiro {
  id       String   @id @default(cuid())
  fecha    DateTime @db.Date
  tipo     TipoRetiro @default(OTRO)
  concepto String
  valor    Int
  saleDe   SaleDe
  nota     String?
  tiendaId String
  tienda   Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([fecha])
  @@index([userId])
  @@index([tipo])
  @@index([tiendaId])
}

model TransferenciaDia {
  id        String   @id @default(cuid())
  fecha     DateTime @db.Date
  total     Int
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  // Un renglón por día POR TIENDA: el unique es compuesto, no global.
  // Con un unique global sobre `fecha` el upsert de una tienda se emparejaba
  // con la fila de otra y le robaba (le cambiaba el `tiendaId`).
  @@unique([fecha, tiendaId])
  @@index([tiendaId])
}

model CierreDiario {
  id                  String   @id @default(cuid())
  fecha               DateTime @db.Date
  cajaApertura        Int      @default(0)
  cajaCierre          Int      @default(0)
  efectivoGuardado    Int      @default(0)
  efectivoRealContado Int?
  tiendaId            String
  tienda              Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  userIdCierre        String
  user                User     @relation(fields: [userIdCierre], references: [id], onDelete: Cascade)
  updatedAt           DateTime @updatedAt

  // Un cierre por día POR TIENDA: el unique es compuesto, no global.
  @@unique([fecha, tiendaId])
  @@index([tiendaId])
}

model PedidoNota {
  id          String   @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  valor       Int
  dia         String
  estado      String?
  nota        String?
  tiendaId    String
  tienda      Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tiendaId])
}
